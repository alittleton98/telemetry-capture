{
  "name": "iRacing (shared memory)",
  "database": "iracing_telemetry",
  "csv_dir": "DataOut\\iRacingTelemetryDumps",
  "working_table": "current_telemetry_session",
  "byte_order": "<",
  "capture": {
    "method": "self_described_memory",
    "mapping": "Local\\IRSDKMemMapFileName",
    "poll_interval_ms": 2,
    "layout_source": "Not iRacing's own: variable names and types from a sample dump in the iracing-sdk-js project",
    "setup": "No setting needed; the mapping exists while the sim is running"
  },
  "notes": [
    "No fixed offsets exist: iRacing publishes each variable's offset, type and count in a table at runtime.",
    "Fields are matched by name. A required field that is missing is an error; any other missing field is NULL.",
    "The list varies by car, because adjusters and sensors differ, and this sample came from one car and sim version.",
    "The runtime table is authoritative: compare its type against struct here and report a mismatch.",
    "Left out: 64-element CarIdx arrays for other cars, and 6-element _ST arrays of 360 Hz samples, which have 60 Hz versions."
  ],
  "active_field": "IsOnTrack",
  "primary_key": null,
  "extra_sql_columns": [
    {
      "name": "row_id",
      "sql": "BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY"
    },
    {
      "name": "time",
      "sql": "TIMESTAMP(3) DEFAULT CURRENT_TIMESTAMP(3)"
    }
  ],
  "fields": [
