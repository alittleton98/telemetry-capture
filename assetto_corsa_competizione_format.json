{
  "name": "Assetto Corsa Competizione (shared memory)",
  "database": "acc_telemetry",
  "csv_dir": "DataOut\\ACCTelemetryDumps",
  "working_table": "current_telemetry_session",
  "byte_order": "<",
  "capture": {
    "method": "shared_memory",
    "pages": {
      "physics": {
        "mapping": "Local\\acpmf_physics",
        "size_bytes": 800
      },
      "graphics": {
        "mapping": "Local\\acpmf_graphics",
        "size_bytes": 1588
      },
      "static": {
        "mapping": "Local\\acpmf_static",
        "size_bytes": 820
      }
    },
    "update_field": "packetId",
    "poll_interval_ms": 2,
    "layout_source": "ACC Shared Memory documentation v1.8.12",
    "setup": "No setting needed; the pages exist while the game is running"
  },
  "notes": [
    "Each field's offset is relative to its page. Sample when the physics packetId changes.",
    "status: 0=off, 1=replay, 2=live, 3=pause. Only status 2 should be recorded.",
    "Fields the documentation marks as not used in ACC are left out, as are carCoordinates and carID for other cars.",
    "Some included fields may read 0; the documentation's working/not-used colour coding could not be read from its text.",
    "The recorder only reads this memory: it polls update_field and compares repeat reads instead of taking the game lock."
  ],
  "active_field": "status",
  "active_value": 2,
  "primary_key": null,
  "extra_sql_columns": [
    {
      "name": "row_id",
      "sql": "BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY"
    },
    {
      "name": "time",
      "sql": "TIMESTAMP(3) DEFAULT CURRENT_TIMESTAMP(3)"
    }
  ],
